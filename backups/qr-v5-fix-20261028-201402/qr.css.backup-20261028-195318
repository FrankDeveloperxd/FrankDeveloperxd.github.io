.qr-v3{color:#142248;max-width:100%;overflow:clip}.qr-v3 *{box-sizing:border-box}.qr-v3-intro{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 22px}.qr-v3-intro h2{font-size:clamp(24px,3vw,38px);margin:0 0 8px;letter-spacing:-.05em}.qr-v3-intro p{margin:0;color:#687692;font-size:14px}.qr-v3-eyebrow{font-size:11px!important;font-weight:800;color:#1759ff!important;margin-bottom:9px!important;letter-spacing:.08em}.qr-v3-local{color:#2157d6;background:#eaf0ff;border-radius:100px;padding:10px 14px;font-size:12px;font-weight:800;white-space:nowrap}.qr-v3-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:20px;align-items:start}.qr-v3-editor,.qr-v3-sticky{background:#fff;border:1px solid #dbe4f6;border-radius:20px;box-shadow:0 12px 35px #0b2d7010;min-width:0}.qr-v3-menu{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-bottom:1px solid #e4e9f5;padding:10px;gap:5px}.qr-v3-menu button{border:0;background:transparent;color:#546686;padding:13px 6px;font-size:13px;font-weight:800;border-radius:11px}.qr-v3-menu button.selected{background:#eaf0ff;color:#1855e6}.qr-v3-panel{padding:25px}.qr-v3-panel h3{font-size:21px;margin:0 0 10px;letter-spacing:-.035em}.qr-v3-panel h4{margin:23px 0 12px;font-size:14px}.qr-hint{color:#6c7a95;font-size:12px;line-height:1.65;margin:7px 0 17px}.qr-v3-types{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.qr-v3-types button,.qr-v3-presets button{color:#34517e;background:#fff;border:1px solid #d6dff2;border-radius:10px;padding:10px 13px;font-size:13px;cursor:pointer}.qr-v3-types button.selected,.qr-v3-options button.selected{color:#1654da;background:#edf3ff;border-color:#8daeff}.qr-v3-fields{display:grid;gap:15px}.qr-v3-fields label,.qr-v3-panel>label,.qr-v3-colors label{display:flex;flex-direction:column;gap:8px;color:#30476b;font-size:13px;font-weight:700}.qr-v3 input:not([type=color]):not([type=range]):not([type=checkbox]),.qr-v3 select,.qr-v3 textarea{border:1px solid #d1dbed;border-radius:10px;padding:12px;font:inherit;color:#142248;background:#fff;min-width:0;width:100%}.qr-v3-presets{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.qr-v3-presets button{display:flex;flex-direction:column;text-align:left;gap:8px}.qr-v3-presets span{height:20px;width:100%;border-radius:6px}.qr-v3-colors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.qr-v3-colors input{height:44px;width:100%;cursor:pointer;border:1px solid #d7e2f2;border-radius:8px;padding:3px}.qr-v3-toggle{flex-direction:row!important;align-items:center;gap:8px!important;margin-top:19px}.qr-v3-toggle input{width:18px;height:18px}.qr-v3-plain{margin-top:14px;background:transparent;color:#1c59d2;border:0;padding:8px 0;font-weight:800}.qr-v3-upload{width:100%;padding:16px;background:#ebf1ff;color:#1754db;border:1px dashed #87aaf2;border-radius:12px;font-weight:800}.qr-v3-image{margin:15px 0;display:flex;gap:12px;align-items:center;font-size:12px;color:#687692;min-width:0}.qr-v3-image img{width:65px;height:65px;object-fit:contain;border-radius:12px;border:1px solid #dce5f6}.qr-v3-image span{min-width:0;flex:1;overflow-wrap:anywhere}.qr-v3-image button{background:transparent;border:0;color:#d13d48}.qr-v3-options{display:grid;gap:8px}.qr-v3-options button{padding:12px;text-align:left;border:1px solid #dce4f4;border-radius:12px;background:#fff;display:flex;flex-direction:column;gap:5px;color:#244065}.qr-v3-options small{color:#657791;line-height:1.5}.qr-v3-range{margin-top:15px}.qr-v3-range input{width:100%}.qr-v3-palette{display:flex;gap:9px}.qr-v3-palette button{width:39px;height:39px;border-radius:12px;border:2px solid #dae3f3}.qr-v3-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.qr-v3-actions button,.qr-v3-shortcuts button{background:#1659ff;border:0;border-radius:11px;padding:12px 15px;color:#fff;font-weight:800;cursor:pointer}.qr-v3-actions button:disabled,.qr-v3-shortcuts button:disabled{opacity:.35;cursor:not-allowed}.qr-v3-sticky{padding:22px;position:sticky;top:98px}.qr-v3-previewhead{display:flex;justify-content:space-between;gap:12px;align-items:start}.qr-v3-previewhead h3{font-size:17px;margin:0 0 5px}.qr-v3-previewhead p{font-size:12px;color:#75819a;margin:0 0 16px}.qr-v3-live{font-size:10px;letter-spacing:.03em;color:#098961;font-weight:800;white-space:nowrap}.qr-v3-art{display:grid;place-items:center;background:#eef3fc;padding:18px;border-radius:16px;min-height:250px}.qr-v3-art img{width:min(100%,390px);height:auto;object-fit:contain;box-shadow:0 12px 22px #0b225414}.qr-v3-art p{text-align:center;color:#647391;font-size:13px}.qr-v3-status{padding:12px;border-radius:12px;margin-top:15px;display:grid;gap:5px;font-size:12px}.qr-v3-status.okay{background:#edf8f4;color:#11694d}.qr-v3-status.warning{background:#fff2e7;color:#985511}.qr-v3-status span{line-height:1.5}.qr-v3-shortcuts{display:flex;gap:9px;margin-top:16px}.qr-v3-shortcuts button{flex:1;font-size:12px}.qr-v3-shortcuts button:first-child{background:#eaf0ff;color:#1954c8}.qr-v3-error{color:#b91c1c;font-size:12px}.qr-help-wrap{display:inline-block;position:relative;vertical-align:middle}.qr-help{width:23px;height:23px;border-radius:50%;background:#eaf0ff;color:#1857d6;border:0;font-size:12px;font-weight:900;cursor:pointer}.qr-help-pop{position:absolute;left:0;top:29px;width:min(260px,80vw);padding:12px;background:#192b51;color:#fff;font-size:12px;line-height:1.6;font-weight:400;z-index:5;border-radius:11px;box-shadow:0 13px 25px #0d245331}@media(max-width:960px){.qr-v3-layout{grid-template-columns:1fr}.qr-v3-sticky{position:static}}@media(max-width:560px){.qr-v3-intro{flex-direction:column;align-items:start}.qr-v3-menu button{font-size:11px;padding:11px 3px}.qr-v3-panel,.qr-v3-sticky{padding:15px}.qr-v3-presets{grid-template-columns:repeat(2,minmax(0,1fr))}.qr-v3-colors{grid-template-columns:repeat(2,minmax(0,1fr))}.qr-v3-shortcuts{flex-wrap:wrap}.qr-v3-shortcuts button{min-width:140px}}

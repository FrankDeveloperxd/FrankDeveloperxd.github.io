.qr-studio{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.85fr);gap:20px}.qr-controls,.qr-preview{background:white;border:1px solid #dce5f8;border-radius:22px;padding:25px;min-width:0}.qr-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:22px}.qr-tabs button{border:1px solid #cbd8f5;padding:9px 14px;border-radius:9px;background:white;color:#1c3565;font-weight:650}.qr-tabs button.active,.qr-actions button{background:#1658ff;color:white;border-color:#1658ff}.qr-fields,.qr-colors{display:grid;gap:14px}.qr-fields label,.qr-colors label,.qr-logo-input{display:flex;flex-direction:column;gap:8px;font-size:13px;color:#344b78;font-weight:700}.qr-fields input,.qr-fields textarea,.qr-fields select,.qr-colors select{width:100%;border:1px solid #cad7ed;padding:12px;border-radius:11px;font:inherit;color:#152747;min-width:0}.qr-controls h3,.qr-preview h3{font-size:19px;margin:20px 0 15px}.qr-colors{grid-template-columns:repeat(3,minmax(0,1fr));align-items:end}.qr-colors input{height:44px;width:100%;cursor:pointer}.qr-logo-input{margin-top:20px}.qr-text-button{background:none;border:0;color:#1559ff;cursor:pointer;margin-top:8px}.qr-preview{display:flex;align-items:center;flex-direction:column;text-align:center}.qr-canvas{background:white;border:1px solid #e4eaf6;border-radius:18px;display:grid;place-items:center;padding:14px;width:min(100%,400px);min-height:250px}.qr-canvas img{width:100%;height:auto;image-rendering:auto}.qr-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:22px}.qr-actions button{border:1px solid #1658ff;border-radius:10px;padding:12px 18px;font-weight:750;cursor:pointer}.qr-actions button:disabled{opacity:.4;cursor:not-allowed}.qr-note{font-size:12px;color:#60718d;line-height:1.65;max-width:380px}.qr-error{color:#b91c1c;font-size:13px}@media(max-width:850px){.qr-studio{grid-template-columns:1fr}}@media(max-width:480px){.qr-controls,.qr-preview{padding:17px}.qr-colors{grid-template-columns:1fr 1fr}.qr-colors label:last-child{grid-column:1/-1}.qr-actions button{width:100%}}

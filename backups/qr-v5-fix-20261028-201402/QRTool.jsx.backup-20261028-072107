import React, {useState,useEffect} from 'react';
import Icon from '../../shared/Icons.jsx';
import QRCode from 'qrcode';
export default function QRTool(){const [text,setText]=useState('https://frankdeveloperxd.github.io');const [size,setSize]=useState(280);const [color,setColor]=useState('#1458ff');const [src,setSrc]=useState('');const [error,setError]=useState('');useEffect(()=>{let dead=false;QRCode.toDataURL(text||' ',{width:size,margin:2,color:{dark:color,light:'#ffffff'},errorCorrectionLevel:'H'}).then(url=>{if(!dead){setSrc(url);setError('')}}).catch(()=>{if(!dead)setError('No se pudo crear el código')});return()=>{dead=true}},[text,size,color]);return <div className="labtool-layout"><div className="labtool-panel"><label>Contenido del QR<textarea rows="4" value={text} onChange={e=>setText(e.target.value)} placeholder="Pega un enlace o escribe un texto"/></label><label>Tamaño<select value={size} onChange={e=>setSize(Number(e.target.value))}><option value={200}>Pequeño · 200 px</option><option value={280}>Mediano · 280 px</option><option value={420}>Grande · 420 px</option></select></label><label>Color del código<input type="color" value={color} onChange={e=>setColor(e.target.value)} /></label></div><div className="labtool-display qr-display">{src&&<img src={src} alt="Código QR generado"/>}{error&&<p>{error}</p>}<a download="franklabs-qr.png" href={src||undefined} className="labtool-primary"><Icon name="download" size={18}/> Descargar PNG</a></div></div>}

const wifiEsc = s => String(s).replace(/([\\;,:\"])/g, '\\$1');
const cardEsc = s => String(s).replace(/\\/g, '\\\\').replace(/\n/g, '\\n').replace(/([;,])/g,'\\$1');
function payloadFor(type, f) {
  if(type==='url') return f.url.trim();
  if(type==='text') return f.text;
  if(type==='wifi') return f.ssid ? `WIFI:T:${f.security};S:${wifiEsc(f.ssid)};P:${f.security==='nopass'?'':wifiEsc(f.password)};;` : '';
  if(type==='contact') return f.name ? `BEGIN:VCARD\nVERSION:3.0\nFN:${cardEsc(f.name)}\nTEL:${f.phone}\nEMAIL:${cardEsc(f.email)}\nEND:VCARD` : '';
  if(type==='email') return f.email ? `mailto:${f.email}?subject=${encodeURIComponent(f.subject)}&body=${encodeURIComponent(f.message)}` : '';
  if(type==='whatsapp') return f.phone.replace(/\D/g,'') ? `https://wa.me/${f.phone.replace(/\D/g,'')}?text=${encodeURIComponent(f.message)}` : '';
  return '';
}
const luminance = h => {const v=[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)/255).map(x=>x<=.04045?x/12.92:((x+.055)/1.055)**2.4);return v[0]*.2126+v[1]*.7152+v[2]*.0722;};
const contrast = (a,b) => {const x=luminance(a),y=luminance(b);return (Math.max(x,y)+.05)/(Math.min(x,y)+.05);};
const loadImage = src => new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=src;});
function download(blob, filename) {const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=filename;a.click();setTimeout(()=>URL.revokeObjectURL(u),5000);}
function sampleColors(img) {
  const c=document.createElement('canvas');c.width=60;c.height=60;const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0,60,60);const {data}=x.getImageData(0,0,60,60);const buckets=new Map();
  for(let j=0;j<data.length;j+=16){if(data[j+3]<170)continue;const r=data[j]>>5,g=data[j+1]>>5,b=data[j+2]>>5;const k=`${r},${g},${b}`;buckets.set(k,(buckets.get(k)||0)+1);}
  return [...buckets.entries()].sort((a,b)=>b[1]-a[1]).slice(0,40).map(([k])=>{const p=k.split(',').map(Number);return '#'+p.map(v=>Math.min(255,v*32+16).toString(16).padStart(2,'0')).join('');}).filter(h=>contrast(h,'#ffffff')>=4.5).slice(0,2);
}
function isFinder(r,c,n){return (r<7&&c<7)||(r<7&&c>=n-7)||(r>=n-7&&c<7);}
function renderCanvas(qr,opts,img,pixelRatio=1) {
  const {size,ink,accent,bg,gradient,style,logoMode,logoScale,frame,title}=opts;
  const margin=4, n=qr.modules.size, side=n+margin*2;
  const output=document.createElement('canvas'); const width=size, footer=frame?68:0;
  output.width=Math.round(width*pixelRatio);output.height=Math.round((width+footer)*pixelRatio);
  const ctx=output.getContext('2d');ctx.scale(pixelRatio,pixelRatio);ctx.fillStyle=bg;ctx.fillRect(0,0,width,width+footer);
  const unit=width/side;
  let fill=ink;
  if(gradient){const g=ctx.createLinearGradient(0,0,width,width);g.addColorStop(0,ink);g.addColorStop(1,accent);fill=g;}
  ctx.fillStyle=fill;
  const data=qr.modules.data;
  for(let r=0;r<n;r++) for(let c=0;c<n;c++) {
    if(!data[r*n+c])continue;
    const x=(c+margin)*unit,y=(r+margin)*unit;
    const finder=isFinder(r,c,n), rounding=finder?0:style==='dots'?unit*.48:style==='rounded'?unit*.27:0;
    const inset=finder?0:style==='dots'?unit*.13:style==='rounded'?unit*.055:0;
    ctx.beginPath();ctx.roundRect(x+inset,y+inset,unit-2*inset,unit-2*inset,rounding);ctx.fill();
  }
  if(img&&logoMode==='center'){
    const ls=width*(logoScale/100), cx=(width-ls)/2, cy=(width-ls)/2, p=unit*1.25;
    ctx.fillStyle=bg;ctx.beginPath();ctx.roundRect(cx-p,cy-p,ls+2*p,ls+2*p,unit*1.8);ctx.fill();
    ctx.save();ctx.beginPath();ctx.roundRect(cx,cy,ls,ls,unit*.7);ctx.clip();ctx.drawImage(img,cx,cy,ls,ls);ctx.restore();
  }
  if(frame){ctx.fillStyle=ink;ctx.font='700 24px system-ui, sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(title||'ESCANÉAME',width/2,width+footer/2, width-20);}
  if(img&&logoMode==='outside'){
    const s=Math.min(44,footer-12);if(frame&&s>0){ctx.fillStyle=bg;ctx.fillRect(16,width+(footer-s)/2,s,s);ctx.drawImage(img,16,width+(footer-s)/2,s,s);}
  }
  return output;
}
